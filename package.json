{
  "name": "@lishenchan/gz-pc",
  "version": "0.1.0",
  "description": "Shared fetch, hooks and utility primitives for GZ frontend applications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./fetch": {
      "import": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "require": {
        "types": "./dist/fetch/index.d.cts",
        "default": "./dist/fetch/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      },
      "require": {
        "types": "./dist/hooks/index.d.cts",
        "default": "./dist/hooks/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node tests/exports/smoke.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "ahooks": "^3.9.7",
    "axios": "^1.13.6"
  },
  "peerDependencies": {
    "@chenhui996/gg-ui": "^0.1.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chenhui996/gg-ui": "0.1.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.4",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "msw": "2.12.7",
    "prettier": "3.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,less}": [
      "prettier --write"
    ]
  }
}
